  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "tailwind-init": "npx tailwindcss init -p",
    "clean": "rm -rf public/*",
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./public/css/tailwind.css --watch",
    "build:eleventy": "eleventy",
    "watch:eleventy": "eleventy --serve --watch",
    "build": "npm run clean && npm run build:css && npm run build:eleventy",
    "dev": "npm run clean && npm-run-all --parallel watch:*",
    "start": "npm run build && eleventy --serve"
  },
